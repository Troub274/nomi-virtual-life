{
  "manifest_version": 3,
  "name": "AI Bridge",
  "version": "1.0.7",
  "description": "AI-controlled conversation bridge with existing Nomi browser and API-room adapters.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://nomi.ai/*",
    "https://*.nomi.ai/*",
    "https://api.nomi.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://nomi.ai/*",
        "https://*.nomi.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.0.7 - schedule command diagnostics"
}
